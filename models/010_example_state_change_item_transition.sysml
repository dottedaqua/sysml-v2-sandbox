package example010 {
    package defs {
        item def I1;
        item def iAnything;
        item def StateTransitionTrigger;
        action def A1 {
            out item iout : I1;
        }
        action def A2 {
            in item iin : I1;
            out item iout : iAnything;
        }
        action def A3 {
            in item iin : iAnything;
        }
    } // package defs

    part p1 {
        action a1 : defs::A1;
        action a2 : defs::A2;
        action a3 : defs::A3;
        flow from a2.iout to a3.iin;

        // port required for "via"
        exhibit state stateMachine {
            entry;
            then state s1 {
                do action s1Do {
                    first perform a1;
                    then send a1.iout to p1;
                    then send new defs::StateTransitionTrigger() to p1;
                    then done;
                }
            }
            accept defs::StateTransitionTrigger via p1 then s2; // Accepts the item from p1 and transitions to state s2
            state s2 {
                do action s2Do {
                    action getDataFromS1 accept iFromS1 : defs::I1;
                    flow from getDataFromS1.iFromS1 to a2.iin;
                    first getDataFromS1;
                    then perform a2;
                    then perform a3;
                    then done;
                }
            }
            then done;
        }
    }
} // package example010

